# Copy to .env and fill in. OpenCode reads process env; Bun loads .env from cwd.

# Provider keys (set only what you use)
KEY_XAI=
KEY_ANTHROPIC=
KEY_GOOGLE=
KEY_COPILOT=
KEY_CODEX=

# Models as provider/model-id (examples, not defaults)
# MODEL_DEFAULT=xai/grok-4.3
# MODEL_MANAGER=xai/grok-4.3
# MODEL_CODE=xai/grok-4.5
# MODEL_PLAN=xai/grok-4.5
# MODEL_EXPLORE=xai/grok-build-0.1
# MODEL_SMALL=xai/grok-build-0.1

MODEL_DEFAULT=
MODEL_MANAGER=
MODEL_CODE=
MODEL_PLAN=
MODEL_EXPLORE=
MODEL_SMALL=

# Optional: honor-code-model switch logs
# HONOR_CODE_MODEL_DEBUG=1
